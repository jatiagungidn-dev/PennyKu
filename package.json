{
  "name": "pennyku",
  "version": "1.0.0",
  "description": "PennyKu adalah aplikasi pencatatan keuangan personal untuk membantu pengguna mencatat pemasukan, pengeluaran, wallet, dan budget secara rapi.",
  "main": "index.js",
  "private": "true",
  "workspaces": [
    "apps/web"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && php artisan serve",
    "dev:web": "cd apps/web && npm run dev",
    "install:all": "npm install && composer install --working-dir=apps/api",
    "migrate": "cd apps/api && php artisan migrate",
    "migrate:fresh": "cd apps/api && php artisan migrate:fresh --seed",
    "build": "npm run build --workspaces=apps/web",
    "lint": "npm run lint --workspaces=apps/web",
    "test": "cd apps/api && php artisan test",
    "format:api": "cd apps/api && vendor\\bin\\pint.bat"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatiagungidn-dev/PennyKu.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jatiagungidn-dev/PennyKu/issues"
  },
  "homepage": "https://github.com/jatiagungidn-dev/PennyKu#readme",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
